<!DOCTYPE html>
<html>
<head>
    <title>Calculator</title>
</head>
<body>

<h2>Calculator</h2>

<form action="CalculatorServlet" method="post">
    Number 1:
    <input type="text" name="num1"><br><br>

    Number 2:
    <input type="text" name="num2"><br><br>

    Operation:
    <select name="op">
        <option value="+">+</option>
        <option value="-">-</option>
        <option value="*">*</option>
        <option value="/">/</option>
    </select>

    <br><br>
    <input type="submit" value="Calculate">
</form>

</body>
</html>
