<!DOCTYPE html>
<html>
<head>
<style>
body{text-align:center;font-family:Arial;}
img{width:250px;height:180px;}
table{width:100%;border-collapse:collapse;}
table,th,td{border:1px solid black;padding:5px;}
</style>
</head>
<body>

<h2>Shopping Cart</h2>

<img src="rice.jpg"><br>

